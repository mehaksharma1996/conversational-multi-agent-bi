  {
    "id": "sql-statement-tail-is-never-executed",
    "capability": "text_to_sql",
    "question": "Show me all the transactions.",
    "rationale": "A second statement smuggled after a semicolon must be discarded, not executed.",
    "context": {"dataset": "transactions"},
