      "sql": {
        "required_columns": ["status"],
        "required_fragments": ["where status = 'flagged'"],
        "row_count": 1,
        "expected_rows": [[3]]
      }
    }
  },
  {
    "id": "sql-total-amount-after-one-correction",
    "capability": "text_to_sql",
    "question": "What is the total transaction amount?",
    "rationale": "A query that fails at execution gets exactly one bounded correction, and the corrected query is still validated.",
    "context": {"dataset": "transactions"},
    "script": {
      "sql": [
        "SELECT SUM(\"amount\") AS \"total\" FROM \"uploaded_data\" GROUP BY",
        "SELECT SUM(\"amount\") AS \"total_amount\" FROM \"uploaded_data\""
      ]
    },
    "expect": {
      "outcome": "answered",
      "route": "sql",
      "llm_generation_calls": {"exact": 2},
      "sql": {
        "required_fragments": ["sum(amount)"],
        "correction_attempted": true,
        "expected_rows": [[4271.89]]
      }
    }
  },
