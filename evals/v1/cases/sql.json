[
  {
    "id": "sql-top-merchants-by-total",
    "capability": "text_to_sql",
    "question": "Show the top three merchants by total amount.",
    "rationale": "A safe query must also be the right query: grouped, summed, sorted descending, limited to three.",
    "context": {"dataset": "transactions"},
    "script": {
      "sql": ["SELECT \"merchant\", SUM(\"amount\") AS \"total_amount\" FROM \"uploaded_data\" GROUP BY \"merchant\" ORDER BY \"total_amount\" DESC LIMIT 3"]
    },
    "expect": {
      "outcome": "answered",
      "route": "sql",
      "llm_generation_calls": {"exact": 1},
      "sql": {
        "required_columns": ["merchant", "amount"],
        "required_fragments": ["group by", "sum(", "order by", "desc", "limit 3"],
        "max_rows": 3,
        "result_columns": ["merchant", "total_amount"],
        "expected_rows": [
          ["Epsilon Electronics", 2319.99],
          ["Beta Books", 960.0],
          ["Alpha Mart", 850.4]
        ]
      }
    }
  },
  {
    "id": "sql-flagged-count-filter",
    "capability": "text_to_sql",
    "question": "How many transactions are flagged?",
