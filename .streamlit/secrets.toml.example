# Copy this file to .streamlit/secrets.toml and fill in real values to enable
# authenticated, multi-user access via Streamlit's native OIDC login
# (st.login() / st.user). See:
# https://docs.streamlit.io/develop/concepts/connections/authentication
#
# If .streamlit/secrets.toml does NOT exist, the app runs without a login
# wall, under a single fixed local-development tenant. That mode is fine for
# a single local user on their own machine, but every user of a shared or
# public deployment would share one workspace. Configure this file before
# hosting the app for more than one person.

[auth]
# Must match the redirect URI registered with your identity provider.
redirect_uri = "http://localhost:8501/oauth2callback"

# A long, random, secret string used to sign the identity cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"

# OAuth client credentials issued by your identity provider (Google,
# Microsoft Entra, Auth0, Okta, or any OIDC-compliant provider).
client_id = "your-oidc-client-id"
client_secret = "your-oidc-client-secret"

# The provider's OIDC discovery document, e.g. for Google:
# https://accounts.google.com/.well-known/openid-configuration
server_metadata_url = "https://your-provider.example.com/.well-known/openid-configuration"
