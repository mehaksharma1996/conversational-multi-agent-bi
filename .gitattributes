*.pdf binary

# Exclude generated interactive diagrams from GitHub language statistics and
# from source-oriented whitespace checks; their bytes are Archify-validated.
.archify/**/*.html linguist-generated -whitespace

# Files executed inside Linux containers must keep LF line endings, even when checked
# out on Windows, or the shell and Docker parsers fail.
*.sh text eol=lf

# Agent skills are hash-pinned in docs/agents/toolkit-manifest.json and mirrored byte-for-byte;
# keep them LF on every platform so a Windows checkout does not look like drift.
.agents/skills/** text eol=lf
.claude/skills/** text eol=lf
.claude/settings.json text eol=lf
docs/agents/toolkit-manifest.json text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
compose.yaml text eol=lf
docker/** text eol=lf

# Retail demo assets are compared byte-for-byte against the deterministic generator, which
# writes LF; keep them LF even when checked out on Windows with core.autocrlf=true.
sample_data/retail_operations.csv text eol=lf
sample_data/retail_operations_ground_truth.json text eol=lf
apps/web/public/demo/retail_operations.csv text eol=lf
sample_data/subscription_churn.csv text eol=lf
