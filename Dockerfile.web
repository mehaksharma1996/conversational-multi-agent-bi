# syntax=docker/dockerfile:1.7
#
# Static web build served by unprivileged nginx, with a same-origin proxy to the API
# (see docker/nginx/default.conf). No API address is compiled into the bundle: the
# client uses relative URLs, so the same image works on any local port.
#
# Base images are pinned by digest; Node matches .nvmrc / package.json "engines".

ARG NODE_IMAGE=node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30-alpine@sha256:ed04ec1ff34502c339ee5c3ae3f855442398edc1d05591e2b98981dcbbd20b1e

# ---------------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS build

WORKDIR /web
# Lockfile first so dependency installation is cached until it changes; `npm ci`
# fails if package.json and package-lock.json disagree, keeping installs reproducible.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The generated API client (src/api/schema.d.ts) is committed and CI-verified against
# openapi/openapi.json, so the build needs nothing outside apps/web.
COPY apps/web/ ./
RUN npm run build

# ---------------------------------------------------------------------------------
FROM ${NGINX_IMAGE} AS runtime

COPY --from=build /web/dist /usr/share/nginx/html
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# The base image already runs as the unprivileged nginx user (uid 101).
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-health || exit 1
