# syntax=docker/dockerfile:1.7
#
# Static web build served by unprivileged nginx, with a same-origin proxy to the API
# (see docker/nginx/default.conf). No API address is compiled into the bundle: the
# client uses relative URLs, so the same image works on any local port.
#
# Base images are pinned by digest in literal FROM lines so Dependabot's docker ecosystem
# proposes digest updates; Node matches .nvmrc / package.json "engines".

FROM node:24.14.1-bookworm-slim@sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c AS build

# ---------------------------------------------------------------------------------

WORKDIR /web
# Lockfile first so dependency installation is cached until it changes; `npm ci`
# fails if package.json and package-lock.json disagree, keeping installs reproducible.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The generated API client (src/api/schema.d.ts) is committed and CI-verified against
# openapi/openapi.json, so the build needs nothing outside apps/web.
COPY apps/web/ ./
RUN npm run build

# ---------------------------------------------------------------------------------
# The -slim variant is the same nginx without the optional dynamic modules (image-filter, xslt,
# geoip, njs). This site serves static files and proxies the API, so it needs none of them, and
# dropping them removes libgd/libtiff/libxslt (CVE-2026-4775 came in through libtiff).
FROM nginxinc/nginx-unprivileged:1.30-alpine-slim@sha256:3af0c10d960cc2502427fe1219c52989d309e7d65596869c60a34fd2fa2406f0 AS runtime

COPY --from=build /web/dist /usr/share/nginx/html
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# The base image already runs as the unprivileged nginx user (uid 101).
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-health || exit 1
