# Copy this file to .env and fill in values locally. Never commit .env.

# Leave blank to use deterministic features without Gemini-backed workflows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API identity mode. `local` uses one fixed development tenant with every capability and must
# remain loopback-only. `oidc` requires every OIDC setting below, accepts verified Bearer JWTs, and
# (with the browser-login settings further down) signs browsers in through a session cookie.
API_AUTH_MODE=local
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Comma-separated asymmetric algorithms only. HS* and `none` are rejected.
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
# Top-level token claim listing roles: viewer, analyst, workspace_admin. Unknown roles grant nothing.
OIDC_ROLES_CLAIM=roles
# Document index backend (ADR 0018). `chroma` (default) needs nothing else. `pgvector` needs
# `pip install -r requirements-postgres.txt`, a PostgreSQL with the vector extension, and POSTGRES_DSN
# supplied by your environment (never commit it). Apply the schema with `python -m scripts.migrate_postgres`
# or set POSTGRES_AUTO_MIGRATE=true; startup otherwise only VERIFIES the schema and refuses to run if it is wrong.
# User-data SQL always stays on SQLite regardless of this setting.
DOCUMENT_INDEX_BACKEND=chroma
POSTGRES_DSN=
POSTGRES_AUTO_MIGRATE=
# Model providers (ADR 0017). Server configuration only; requests can never choose a provider.
# LLM_PROVIDERS is an ordered fallback chain of: gemini, anthropic, ollama. Default is gemini alone.
LLM_PROVIDERS=gemini
# Optional cheaper model used for routing/criteria extraction; empty means use the main model.
GEMINI_MODEL_FAST=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FAST=
# Local model. The endpoint counts as "local" only if it is loopback or listed in OLLAMA_TRUSTED_HOSTS
# (a comma-separated list of container-internal host names you vouch for).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_MODEL_FAST=
OLLAMA_TRUSTED_HOSTS=
# Task routing: which tier each purpose uses (fast or strong). Defaults shown.
LLM_TIER_ROUTE=fast
LLM_TIER_CRITERIA_EXTRACTION=fast
LLM_TIER_SQL_GENERATION=strong
LLM_TIER_SQL_CORRECTION=strong
LLM_TIER_RAG_ANSWER=strong
# Hybrid retrieval (dense + BM25, ADR 0016). Set to false to fall back to dense-only retrieval.
RETRIEVAL_HYBRID=true
# Optional USD price per million tokens, used only to ESTIMATE per-call cost in telemetry (not billing).
# Set both or neither.
LLM_INPUT_COST_PER_MILLION_USD=
LLM_OUTPUT_COST_PER_MILLION_USD=
# Read-only MCP server (`python -m apps.mcp`, stdio; docs/operations/mcp-server.md). These are read by
# that process only: MCP_DATABASE_PATH (required), MCP_TABLE_NAME, MCP_TENANT_SUBJECT, MCP_MAX_ROWS,
# MCP_QUERY_TIMEOUT_SECONDS, MCP_VECTORSTORE_DIR, MCP_COLLECTION_NAME.
# Browser session transport (ADR 0013). WEB_ORIGIN is the single origin allowed to send
# cookie-authenticated state-changing requests, e.g. https://bi.example.com. The API sends no CORS headers.
WEB_ORIGIN=
API_SESSION_MAX_AGE_SECONDS=28800
API_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Browser sign-in (authorization code + PKCE). All of the first four plus WEB_ORIGIN are required
# together; the redirect URI must be WEB_ORIGIN + /api/v1/auth/callback. Leave OIDC_CLIENT_SECRET
# empty for a public client. Never commit a real secret. Scopes are space-separated.
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid

# Per-session SQLite and ChromaDB workspaces are created below APP_DATA_DIR.
APP_DATA_DIR=data
# Pinned to an immutable revision by default when using the default model
# name (see src/documents/embedding.py); set to a local directory path for
# a preloaded/offline model. Set HF_HUB_OFFLINE=1 to force fully offline
# operation once a model has been cached locally at least once.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Leave blank to run with unencrypted SQLite storage (local/dev only, a
# visible warning is shown). Set to a 64-character hex string (32 bytes) to
# encrypt tabular data at rest via SQLCipher. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
APP_ENCRYPTION_KEY=

# How often (in minutes) stale session cleanup is allowed to run. Default 15.
SESSION_CLEANUP_INTERVAL_MINUTES=15

# Local workspace activity extends this expiry window. The FastAPI repository
# removes expired resources and files on their next access; default 24 hours.
SESSION_RETENTION_HOURS=24

# Process-local fixed-window limits per tenant and workspace. These are generous local defaults,
# not distributed quotas; every API replica maintains independent counters.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TABULAR_UPLOADS=60
RATE_LIMIT_DOCUMENT_INDEXES=20
RATE_LIMIT_ANALYSES=60
RATE_LIMIT_MESSAGES=120

# Maximum number of embedding vectors held in the process-local LRU. Cache keys are scoped to a
# tenant/workspace and model identity; source text is never retained.
EMBEDDING_CACHE_MAX_ENTRIES=10000

# Set to true to withhold ALL hosted-provider credentials (Gemini, Anthropic, non-local Ollama), even
# if set. Forces the app back to deterministic analytics/dashboard/reports only, plus a local model if
# one is configured below. This is the only complete guarantee that no data leaves the machine.
LOCAL_ONLY_MODE=

# Set to true to omit real column sample values from SQL-generation prompts
# (schema and dtypes are still sent). Reduces SQL-generation quality slightly
# in exchange for sending less real data to Gemini.
GEMINI_EXCLUDE_SAMPLE_VALUES=

# By default, only route names, timings, and question/SQL length are logged.
# Set to true to additionally log raw question text and generated SQL at
# DEBUG level for local troubleshooting. Do not enable in a shared/hosted
# deployment: this puts user questions and SQL into server logs.
DEBUG_LOG_RAW_CONTENT=

# Maximum cosine distance (all-MiniLM-L6-v2) for a retrieved document chunk
# to be considered relevant; farther matches are rejected rather than used
# as evidence. Default 0.7, empirically set from measured distances: on-topic
# questions landed at 0.21-0.66, clearly off-topic ones at 0.91-1.0. Raise it
# to accept looser matches, or set it close to 2.0 to effectively disable
# filtering.
RETRIEVAL_MAX_DISTANCE=0.7

# Caps on retained chat history so a long session doesn't grow memory use
# without bound. Older messages beyond MAX_CHAT_DATAFRAMES_RETAINED keep
# their text but drop the full result DataFrame.
MAX_CHAT_MESSAGES=50
MAX_CHAT_DATAFRAMES_RETAINED=10

# --- Docker Compose (see docs/operations/local-containers.md) ---------------------
# Host ports; compose publishes them on 127.0.0.1 only. Browser authentication,
# roles, CSRF/CORS, and logout are not complete, so do not expose these ports.
WEB_PORT=8080
STREAMLIT_PORT=8501

# Where append-only audit events are written. Compose mounts a dedicated volume at
# /audit; outside containers this defaults to APP_DATA_DIR/audit.
AUDIT_LOG_DIR=

# Remove workspace directories that no live API process owns when the API starts
# (API metadata is process-local, so after a restart they are unreachable). Compose
# enables this for its single API container. Leave it off when more than one process
# shares a data directory.
SWEEP_ORPHANED_WORKSPACES=

# Set to 1 to forbid model downloads once the embedding model is cached
# (prefetch it with: docker compose run --rm api python -m scripts.prefetch_model).
HF_HUB_OFFLINE=
