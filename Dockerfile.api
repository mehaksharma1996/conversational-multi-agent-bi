# syntax=docker/dockerfile:1.7
#
# API (and Streamlit compatibility surface) image.
#
# Multi-stage: dependencies are built in a throwaway stage and only the virtual
# environment and application code reach the runtime stage. The runtime image runs
# as a fixed non-root user, holds no secrets, and is designed for a read-only root
# filesystem: all state lives in the /data, /audit, and /models volumes and /tmp.
#
# Base image is pinned by digest in a literal FROM line so Dependabot's docker ecosystem
# proposes digest updates. Review each update, rebuild, and run the smoke test
# (docs/operations/local-containers.md).

FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS python-base

# ---------------------------------------------------------------------------------
FROM python-base AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /build
COPY requirements.txt requirements.lock ./

# CPU-only PyTorch at the version pinned in requirements.lock. sentence-transformers
# runs on CPU here, and the default Linux wheel drags in several gigabytes of CUDA
# libraries. The remaining runtime dependencies are then installed with the lock file
# acting as a constraint, so only what requirements.txt needs is installed, at the
# tested versions.
RUN TORCH_VERSION="$(sed -n 's/^torch==//p' requirements.lock)" \
    && test -n "${TORCH_VERSION}" \
    && pip install "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt -c requirements.lock

# ---------------------------------------------------------------------------------
FROM python-base AS runtime

# HOME and caches point at /tmp because the root filesystem is read-only; /tmp is a
# tmpfs at runtime. Telemetry from third-party libraries is disabled.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}" \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    APP_DATA_DIR=/data \
    AUDIT_LOG_DIR=/audit \
    HF_HOME=/models \
    HF_HUB_DISABLE_TELEMETRY=1 \
    ANONYMIZED_TELEMETRY=False \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data /audit /models \
    && chown app:app /data /audit /models

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY app.py ./
COPY .streamlit/config.toml ./.streamlit/config.toml
COPY apps ./apps
COPY config ./config
COPY packages ./packages
COPY scripts ./scripts
COPY src ./src

USER 10001:10001

# Fail the build if the API or Streamlit cannot even be imported (missing native
# library, broken dependency set). Nothing is written to disk.
RUN python -c "import apps.api.main, streamlit"

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4).status == 200 else 1)"]

# Exec form so uvicorn is PID 1's child under `init: true` and receives SIGTERM;
# in-flight requests get 20 seconds to finish before shutdown.
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-access-log", "--timeout-graceful-shutdown", "20"]
