  "cards": [
    {
      "dot": "amber",
      "title": "Models propose",
      "items": [
        "Route choice, cited answers, policy criteria and SQL drafts come from the model provider",
        "Hosted providers are used only after consent and receive minimized context"
      ]
    },
    {
      "dot": "rose",
      "title": "Code enforces",
      "items": [
        "SELECT-only validation, then policy-to-SQL predicate verification",
        "Optional approval pause, then read-only, row-capped execution"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local-first scope",
      "items": [
        "One API process with workspace SQLite and vector stores",
        "Result summaries are computed by code, not sent back to the model"
      ]
    }
  ]
