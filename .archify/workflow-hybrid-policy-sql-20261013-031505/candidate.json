  "cards": [
    {
      "dot": "amber",
      "title": "Model proposes",
      "items": [
        "Route, cited answer, policy criteria and SQL are model drafts",
        "Retrieved excerpts are treated as untrusted data"
      ]
    },
    {
      "dot": "rose",
      "title": "Code decides",
      "items": [
        "SQL safety runs first, then structural policy verification",
        "Mismatch or unsafe SQL returns the cited document answer only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded claim",
      "items": [
        "A structural match does not prove the policy is complete or correct",
        "Approved or edited SQL repeats both checks before it can run"
      ]
    }
